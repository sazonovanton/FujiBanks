<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and above. Same contents as backup_rules.xml, declared twice
  because the two mechanisms do not read each other's file.

  cloud-backup and device-transfer are listed separately so that moving to a new
  phone over a cable carries the same set as a restore from Google's backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="recipes.json" />
        <include domain="file" path="packs.json" />
        <include domain="file" path="backups/" />
        <include domain="file" path="photos/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="recipes.json" />
        <include domain="file" path="packs.json" />
        <include domain="file" path="backups/" />
        <include domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>
