<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below (fullBackupContent).

  The library and the bank backups are worth carrying to a new phone: losing
  them means re-typing every recipe and losing the only record of what the
  camera held before the first write. The property-sweep baseline is not — it
  describes one camera on one day and is regenerated by pressing Baseline.
-->
<full-backup-content>
    <include domain="file" path="recipes.json" />
    <include domain="file" path="packs.json" />
    <include domain="file" path="backups/" />
    <include domain="file" path="photos/" />
</full-backup-content>
