# Local toolchain for this project — nothing is installed system-wide.
# Copy to env.sh (gitignored) and point these at your own toolchain.
# Usage: source env.sh
export JAVA_HOME=/path/to/toolchain/jdk-17.0.20.1+1
export ANDROID_SDK_ROOT=/path/to/toolchain/android-sdk
export ANDROID_HOME=$ANDROID_SDK_ROOT
export PATH=$JAVA_HOME/bin:/path/to/toolchain/gradle-8.11.1/bin:$ANDROID_SDK_ROOT/platform-tools:$PATH
# sdkmanager and Gradle talk to Google directly; the shell proxy breaks them.
unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy
