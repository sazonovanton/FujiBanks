# Copy to keystore.properties (which is gitignored) and fill in.
# Only needed to build a signed release; debug builds do not use this at all.
#
# Create the key first, outside the repository:
#
#   keytool -genkeypair -v \
#     -keystore ~/.android/fujibanks-release.jks \
#     -alias fujibanks -keyalg RSA -keysize 2048 -validity 10950
#
# Keep the .jks and these passwords backed up somewhere safe. Android identifies
# an app by its signing key: lose it and no future build can update an installed
# copy — the only way forward is uninstall and reinstall, taking the recipe
# library and every backup with it.

storeFile=/absolute/path/to/fujibanks-release.jks
storePassword=
keyAlias=fujibanks
keyPassword=
